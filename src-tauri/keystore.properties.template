# Android release-signing properties for fgw-android.
#
# This template lives at `src-tauri/keystore.properties.template` (outside
# the gitignored `src-tauri/gen/` tree so it can be committed). Copy it to
# `src-tauri/gen/android/keystore.properties` and fill in the four values
# below. The real `keystore.properties` lives inside `src-tauri/gen/` and is
# gitignored by that directory rule — never commit it.
#
# To generate the keystore (one-time, before first release build):
#
#   keytool -genkey -v -keystore /path/to/your/secrets/fgw-android.keystore \
#     -alias fgw -keyalg RSA -keysize 4096 -validity 25000
#
# Back up the keystore file to two offsite locations immediately. If you
# lose it, you cannot publish updates to the same Android package ID; the
# next release would have to use a new package ID, breaking in-place
# upgrades for every existing install.

storeFile=/Users/<you>/secrets/fgw-android.keystore
storePassword=<keystore-password>
keyAlias=fgw
keyPassword=<key-password>
